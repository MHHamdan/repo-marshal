{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MHHamdan/repo-marshal/schemas/plan-0.1.json",
  "title": "RepoMarshal Change Plan",
  "$defs": {
    "risk": {
      "enum": [
        "low",
        "standard",
        "elevated"
      ]
    },
    "kind": {
      "enum": [
        "docs",
        "format",
        "lint",
        "typecheck",
        "unit",
        "integration",
        "secrets",
        "dep_audit",
        "security_scan",
        "skill_audit",
        "runtime",
        "a11y"
      ]
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "A",
            "M",
            "D",
            "R"
          ]
        },
        "old_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binary": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "status",
        "old_path",
        "added",
        "removed",
        "binary",
        "truncated"
      ]
    },
    "changeSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "head": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/changedFile"
          }
        },
        "uncommitted": {
          "type": "boolean"
        },
        "opaque": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "base",
        "head",
        "tree_digest",
        "files",
        "uncommitted",
        "opaque"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "cost": {
          "enum": [
            "cheap",
            "standard",
            "expensive"
          ]
        },
        "source": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "command",
            "native"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "definition_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition_changed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "argv",
        "cwd",
        "scope",
        "cost",
        "source",
        "provider",
        "available",
        "unavailable_reason",
        "timeout_s",
        "definition_digest",
        "definition_changed"
      ]
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
        },
        "domain": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "risk",
        "files",
        "detail"
      ]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text",
        "signal"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "status": {
          "enum": [
            "REQUIRED",
            "SKIPPED",
            "NOT_APPLICABLE",
            "UNAVAILABLE"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "gate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "taint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      },
      "required": [
        "kind",
        "status",
        "reasons",
        "gate_id",
        "taint"
      ]
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "est_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "why",
        "priority",
        "est_tokens"
      ]
    },
    "contextPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextItem"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextItem"
          }
        },
        "budget_tokens": {
          "type": "integer"
        },
        "selected_tokens": {
          "type": "integer"
        },
        "candidate_tokens": {
          "type": "integer"
        },
        "method": {
          "const": "deterministic-heuristic"
        },
        "estimate": {
          "const": "bytes/4"
        }
      },
      "required": [
        "items",
        "excluded",
        "budget_tokens",
        "selected_tokens",
        "candidate_tokens",
        "method",
        "estimate"
      ]
    },
    "skillPick": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "matched_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score": {
          "type": "integer",
          "minimum": 1
        },
        "trust": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "matched_domains",
        "score",
        "trust"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "forecast",
        "binding"
      ]
    },
    "task": {
      "type": [
        "string",
        "null"
      ]
    },
    "change": {
      "$ref": "#/$defs/changeSet"
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "context": {
      "$ref": "#/$defs/contextPlan"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillPick"
      }
    },
    "evidence_level": {
      "enum": [
        "standard",
        "elevated"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "source",
        "digest"
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "name",
        "version"
      ]
    }
  },
  "required": [
    "schema_version",
    "plan_hash",
    "mode",
    "task",
    "change",
    "signals",
    "domains",
    "risk",
    "inventory",
    "gates",
    "context",
    "skills",
    "evidence_level",
    "policy",
    "generator"
  ]
}
